{
  "manifest_version": 3,
  "name": "Gantt View for Linear",
  "version": "0.2.0",
  "description": "Adds a Gantt tab to Linear projects and lets you change issue due dates, status, and assignee from the chart.",
  "minimum_chrome_version": "120",
  "key": "",
  "permissions": ["storage", "identity"],
  "host_permissions": ["https://api.linear.app/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Gantt View for Linear",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  },
  "options_page": "options.html",
  "content_scripts": [{
    "matches": ["https://linear.app/*"],
    "js": ["src/gantt-url.js"],
    "run_at": "document_start"
  }, {
    "matches": ["https://linear.app/*"],
    "js": ["src/content.js"],
    "run_at": "document_idle"
  }],
  "web_accessible_resources": [{
    "resources": ["panel.html", "src/page/adapter.js", "src/project-url.js"],
    "matches": ["https://linear.app/*"]
  }]
}
